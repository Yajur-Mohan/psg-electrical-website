# Copy to .env.local and change every value.
# First admin account, created automatically on first login attempt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Optional: where the SQLite file lives (defaults to ./data/hydra.db)
# DATABASE_PATH=./data/hydra.db
