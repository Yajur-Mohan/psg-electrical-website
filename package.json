    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.1",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
