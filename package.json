    "@theatre/core": "^0.7.2",
    "bcryptjs": "^3.0.3",
    "curtainsjs": "^8.1.6",
    "framer-motion": "^13.5.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
